# Copy this file to .env and fill in real values.
# Nothing here is required to run locally — every var has a safe dev default —
# but you MUST set real values before deploying to production.

# --- Core ---
DJANGO_SETTINGS_MODULE=ecommerce_app.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# --- Database ---
# Leave unset locally to use SQLite automatically.
# On Vercel + Supabase, set this to your Supabase Postgres connection string:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Email (leave blank locally: emails print to the console instead) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Cloudinary (leave blank locally: files are stored on local disk instead) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Paystack ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Google OAuth (leave blank to hide the "Continue with Google" button) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Production only ---
ALLOWED_HOSTS=your-app.vercel.app
