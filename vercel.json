{
  "version": 2,
  "env": {
    "DJANGO_SETTINGS_MODULE": "ecommerce_app.settings.production"
  },
  "build": {
    "env": {
      "DJANGO_SETTINGS_MODULE": "ecommerce_app.settings.production"
    }
  },
  "builds": [
    {
      "src": "ecommerce_app/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.12" }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "staticfiles" }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "ecommerce_app/wsgi.py" }
  ]
}